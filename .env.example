# Listings added from the admin (written to .env.local by clp-api/scripts/deploy.sh).
# Base URL of the listings API (API Gateway); unset = only the built-in directory cards are shown.
NEXT_PUBLIC_LISTINGS_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
# Base URL of the listing images bucket.
NEXT_PUBLIC_LISTINGS_MEDIA_URL=https://clp-listings-media.s3.us-east-1.amazonaws.com
# The admin (partner sign-up: "Become a partner").
NEXT_PUBLIC_ADMIN_URL=https://d2v5g3qu3uuuvq.cloudfront.net

# Live Messages (clp-api scripts/deploy-messages.sh prints it)
NEXT_PUBLIC_MESSAGES_WS_URL=wss://bqd28mhzo2.execute-api.us-east-1.amazonaws.com/live
